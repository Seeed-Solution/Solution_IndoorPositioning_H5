# 环境配置示例

# 开发环境配置
# 是否使用远程开发模式
# false = 使用本地Vite代理 (默认，推荐用于本地开发)
# true = 直接请求远程服务器 (用于调试远程服务器)
VITE_USE_REMOTE=false

# 生产环境配置
# 是否为本地容器部署模式
# true = web和后端在同一容器中，使用相对路径
# false = 访问远程服务器 (默认)
VITE_LOCAL_CONTAINER=false

# 部署模式说明：
# 
# 1. 开发模式 (NODE_ENV=development)：
#    - VITE_USE_REMOTE=false: 通过 vite 代理 /api 到 127.0.0.1:8022 (推荐)
#    - VITE_USE_REMOTE=true: 直接请求 http://127.0.0.1:8022/api
#
# 2. 生产环境-远程模式 (NODE_ENV=production, VITE_LOCAL_CONTAINER=false)：
#    - 访问 https://indoorpositioning-demo.seeed.cc/api
#    - WebSocket: wss://indoorpositioning-demo.seeed.cc/ws
#
# 3. 生产环境-本地容器模式 (NODE_ENV=production, VITE_LOCAL_CONTAINER=true)：
#    - web和后端通过 uvicorn 在同一容器中运行
#    - API: /api (相对路径，会转发到本地8022端口)
#    - WebSocket: 动态构建为当前域名的 /ws 路径