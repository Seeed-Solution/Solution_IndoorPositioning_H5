# Dockerfile-local only (BuildKit reads <Dockerfile>.dockerignore instead of .dockerignore).
# Test/remote runtime configs carry real credentials; Dockerfile-remote still needs them,
# so they are excluded here rather than in the shared .dockerignore.
# The local image default config comes only from *_local.json.
server/config/json/server_runtime_config.json
server/config/json/dashboard_config.json
