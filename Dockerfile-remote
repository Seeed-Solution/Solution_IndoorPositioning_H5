# Multi-stage Dockerfile for Indoor Positioning System
FROM node:18-alpine AS frontend-builder

# Set working directory for frontend build
WORKDIR /app/web

# Copy package files
COPY web/package*.json ./

# Install frontend dependencies
RUN npm install --no-audit --no-fund --silent

# Copy web source files
COPY web/ ./

# Build frontend
RUN npm run build:remote

# Python runtime stage
FROM python:3.12-slim AS runtime

# Install system dependencies including nginx
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    nginx \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

COPY server/ ./server/
COPY run_in_docker.sh ./
COPY web/web.py ./web/
COPY nginx.conf /etc/nginx/sites-available/default

COPY server/config/json/server_runtime_config.json ./server/config/server_runtime_config.json
COPY server/config/json/dashboard_config.json ./server/config/dashboard_config.json

# Install Python dependencies
RUN pip install -r /app/server/requirements.txt

# Copy built frontend from previous stage to nginx html directory
COPY --from=frontend-builder /app/web/dist /usr/share/nginx/html/web

# Expose ports
EXPOSE 5173

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV NODE_ENV=production
ENV VITE_LOCAL_CONTAINER=false

# Health check
#HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
#    CMD python -c "import requests; requests.get('http://localhost:8000/api/auth/check', timeout=5)" || exit 1

# Default command - run backend server
CMD ["/bin/bash", "run_in_docker.sh"]